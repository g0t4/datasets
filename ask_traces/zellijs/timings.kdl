layout {
    tab name="Timings" {
        pane split_direction="horizontal" {
            pane split_direction="vertical" {
                pane name="vllm ds4flash" command="view_trace" {
                    args "../agents/2026-11/2026-11-08_002/1794158484-trace.json"
                }
            }
            pane split_direction="vertical" {
                // // TODO more cases
                // pane name="vllm ds4flash" command="view_trace" {
                //     args "../agents/2026-11/2026-11-08_002/1794158484-trace.json"
                // }
            }
        }
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
    }
}
